project Subtitle_Pipeline is
   for Source_Dirs use ("src");
   for Main use ("subtitle_pipeline.adb");
   for Object_Dir use "obj/spark";

   package Compiler is
      for Default_Switches ("Ada") use ("-gnatW8", "-gnat2022");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=30");
   end Prove;
end Subtitle_Pipeline;
