project Shadow_Node is
   for Source_Dirs use ("src");
   for Main use ("shadow_node_main.adb");
   for Object_Dir use "obj/shadow";
   for Source_Files use (
      "shadow_node.ads",
      "shadow_node.adb",
      "shadow_node_main.adb",
      "prometheus_exporter.ads",
      "prometheus_exporter.adb"
   );
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatW8", "-gnat2022", "-gnata");
   end Compiler;
end Shadow_Node;
