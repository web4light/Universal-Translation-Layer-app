project Hermetic_Vault is
   for Source_Dirs use ("src");
   for Object_Dir use "obj/spark_vault";
   for Main use ("hermetic_vault.adb");
   
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatW8", "-gnat2022", "-gnata");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--timeout=30");
   end Prove;
end Hermetic_Vault;
