project SPARK_Agent is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Main use ("spark_agent.adb");

   package Compiler is
      for Default_Switches ("Ada") use ("-gnat2022", "-gnatWa", "-gnatW8", "-gnata", "-gnatVa");
   end Compiler;

   package Prove is
      for Proof_Switches ("Ada") use ("--level=2", "--report=all", "--timeout=10");
   end Prove;
end SPARK_Agent;
