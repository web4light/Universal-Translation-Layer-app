project Prometheus_Server is
   for Source_Dirs use ("src");
   for Main use ("prometheus_server.adb");
   for Object_Dir use "obj/prom_server";
   for Exec_Dir use "bin";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnatW8", "-gnat2022", "-O2", "-gnatn");
   end Compiler;
   package Binder is
      for Default_Switches ("Ada") use ("-E");  -- full exception traceback
   end Binder;
end Prometheus_Server;
