project Dirigent_Main is
   for Source_Dirs use ("src");
   for Main use ("dirigent_main.adb");
   for Object_Dir use "obj/dirigent";
   for Exec_Dir use "bin";
   for Source_Files use ("dirigent_main.adb", "dirigent.ads", "dirigent.adb");
   package Compiler is
      for Default_Switches ("Ada") use ("-gnatW8", "-gnat2022", "-O2");
   end Compiler;
end Dirigent_Main;
