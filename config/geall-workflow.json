        "jsonBody": "={\n  \"model\": \"gemma3:4b\",\n  \"prompt\": \"{{ $json.chatInput }}\",\n  \"stream\": false\n}",
        "options": {
          "timeout": 120000
        }
      },
      "id": "ollama-request",
      "name": "Ollama - gemma3:4b",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "={{ $json.response }}"
      },
      "id": "respond",
      "name": "Geall Odpověď",
